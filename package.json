{
  "name": "dado-rpg-desktop",
  "version": "2.0.0",
  "private": true,
  "description": "Rolador de dados de RPG para desktop",
  "main": "electron/main.cjs",
  "scripts": {
    "build:css": "node scripts/build-css.mjs",
    "build:js": "node scripts/build-js.mjs",
    "build": "npm run build:css && npm run build:js",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "smoke:desktop": "npm run build && node scripts/desktop-smoke.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "electron": "^44.0.0",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0"
  }
}
